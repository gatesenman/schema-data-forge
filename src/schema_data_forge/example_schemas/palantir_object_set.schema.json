{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palantir.com/ontology/v1/object-set.schema.json",
  "title": "Palantir ontology object set",
  "description": "A page of ontology objects as returned by an object-set search, including the objects themselves and the links between them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ontologyApiName", "objectType", "objects", "page"],
  "properties": {
    "ontologyApiName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]{2,63}$"
    },
    "objectType": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{2,63}$"
    },
    "objects": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/ontologyObject" }
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "hasMore"],
      "properties": {
        "size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "hasMore": { "type": "boolean" },
        "nextPageToken": { "type": "string", "minLength": 8 }
      },
      "dependentRequired": { "nextPageToken": ["hasMore"] }
    }
  },
  "$defs": {
    "ontologyObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryKey", "rid", "title", "properties", "lifecycle"],
      "properties": {
        "primaryKey": { "type": "string", "minLength": 3, "maxLength": 64 },
        "rid": {
          "type": "string",
          "pattern": "^ri\\.ontology\\.main\\.object\\.[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "lifecycle": { "enum": ["ACTIVE", "ARCHIVED", "PENDING_REVIEW"] },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "classification", "createdAt"],
          "properties": {
            "name": { "type": "string", "minLength": 2 },
            "classification": { "enum": ["UNCLASSIFIED", "CONFIDENTIAL", "SECRET"] },
            "createdAt": { "type": "string", "format": "date-time" },
            "riskScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "tags": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 6,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" }
            },
            "location": { "$ref": "#/$defs/geoPoint" }
          }
        }
      }
    },
    "geoPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linkTypeApiName", "sourcePrimaryKey", "targetPrimaryKey"],
      "properties": {
        "linkTypeApiName": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{2,63}$" },
        "sourcePrimaryKey": { "type": "string", "minLength": 3 },
        "targetPrimaryKey": { "type": "string", "minLength": 3 }
      }
    }
  }
}
